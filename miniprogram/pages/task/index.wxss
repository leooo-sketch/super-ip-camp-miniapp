.task-page { padding: 26rpx; }
.error-panel { padding: 24rpx; color: #9f211d; background: #ffe9e7; border-radius: 10rpx; font-size: 24rpx; }
.status-panel,.detail-panel { padding: 28rpx; background: #fff; border: 1rpx solid #e4e6ea; border-radius: 12rpx; }
.status-panel { border-top: 7rpx solid #f1b932; }
.status-succeeded { border-top-color: #147d78; }
.status-failed { border-top-color: #e63b32; }
.status-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 26rpx; }
.status-label { color: #147d78; font-size: 23rpx; font-weight: 750; }
.status-processing .status-label,.status-queued .status-label { color: #8b6504; }
.status-failed .status-label { color: #b92520; }
.task-title { margin-top: 7rpx; font-size: 34rpx; font-weight: 800; }
.progress-number { font-size: 38rpx; font-weight: 800; }
.status-note { margin-top: 18rpx; color: #73777f; font-size: 21rpx; line-height: 1.5; }
.result-section { margin-top: 22rpx; }
.video-shell { position: relative; width: 100%; height: 820rpx; }
.result-video,.demo-result { width: 100%; height: 820rpx; border-radius: 12rpx; background: #151719; }
.ai-label { position: absolute; top: 18rpx; right: 18rpx; z-index: 3; padding: 8rpx 14rpx; color: #fff; background: rgba(0,0,0,.72); border-radius: 6rpx; font-size: 20rpx; font-weight: 750; }
.demo-result { position: relative; overflow: hidden; }
.demo-result image { width: 100%; height: 100%; opacity: .42; }
.demo-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60rpx; color: #fff; text-align: center; }
.demo-check { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; color: #151719; background: #f1b932; border-radius: 50%; font-size: 44rpx; font-weight: 800; }
.demo-title { margin-top: 24rpx; font-size: 36rpx; font-weight: 800; }
.demo-copy { margin-top: 10rpx; color: rgba(255,255,255,.76); font-size: 22rpx; line-height: 1.5; }
.disclosure { padding: 20rpx 22rpx; color: #5d450c; background: #fff1c7; border-radius: 0 0 10rpx 10rpx; font-size: 20rpx; line-height: 1.55; }
.detail-panel { margin-top: 22rpx; }
.detail-title { margin-bottom: 12rpx; font-size: 28rpx; font-weight: 750; }
.detail-row { display: flex; justify-content: space-between; gap: 30rpx; padding: 19rpx 0; border-bottom: 1rpx solid #eceef0; color: #777a80; font-size: 22rpx; }
.detail-row:last-child { border-bottom: 0; }
.detail-value { max-width: 430rpx; color: #151719; text-align: right; }
.code { color: #147d78; font-family: monospace; font-size: 19rpx; }
.works-button { margin-top: 22rpx; height: 84rpx; color: #151719; background: #fff; border: 1rpx solid #d9dce0; line-height: 84rpx; }
