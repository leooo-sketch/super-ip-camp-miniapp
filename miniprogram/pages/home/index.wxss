.home-page {
  padding-top: 22rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.brand-line {
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 800;
}

.brand-note {
  margin-top: 5rpx;
  color: #73777f;
  font-size: 20rpx;
}

.wallet {
  display: grid;
  grid-template-columns: auto auto auto;
  align-items: center;
  gap: 10rpx;
  min-height: 66rpx;
  padding: 0 14rpx 0 18rpx;
  color: #fff;
  background: #151719;
  border-radius: 10rpx;
}

.wallet-label {
  color: #f1b932;
  font-size: 17rpx;
  font-weight: 800;
}

.wallet-value {
  font-size: 25rpx;
  font-weight: 750;
}

.wallet-plus {
  font-size: 30rpx;
}

.demo-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  color: #5b4208;
  background: #fff1c7;
  border-left: 6rpx solid #f1b932;
  border-radius: 8rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.demo-detail {
  font-weight: 450;
}

.hero {
  position: relative;
  overflow: hidden;
  height: 390rpx;
  border-radius: 12rpx;
  background: #151719;
}

.hero-image,
.hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-image {
  object-position: 60% center;
}

.hero-shade {
  background: linear-gradient(90deg, rgba(8, 9, 10, 0.93) 0%, rgba(8, 9, 10, 0.55) 58%, rgba(8, 9, 10, 0.08) 100%);
}

.hero-content {
  position: absolute;
  left: 28rpx;
  bottom: 30rpx;
  width: 72%;
  color: #fff;
}

.hero-kicker {
  margin-bottom: 16rpx;
  color: #f1b932;
  font-size: 17rpx;
  font-weight: 800;
}

.hero-title {
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 800;
}

.hero-meta {
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 20rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 16rpx;
}

.quick-action {
  position: relative;
  min-height: 190rpx;
  padding: 20rpx;
  color: #fff;
  border-radius: 10rpx;
}

.quick-red {
  background: #e63b32;
}

.quick-dark {
  background: #202326;
}

.quick-index {
  color: rgba(255, 255, 255, 0.62);
  font-size: 18rpx;
  font-weight: 800;
}

.quick-title {
  margin-top: 30rpx;
  font-size: 30rpx;
  font-weight: 750;
}

.quick-note {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 19rpx;
}

.quick-arrow {
  position: absolute;
  right: 18rpx;
  bottom: 14rpx;
  font-size: 34rpx;
}

.workflow-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.principle {
  display: flex;
  gap: 22rpx;
  margin-top: 34rpx;
  padding: 24rpx;
}

.principle-mark {
  flex: 0 0 auto;
  align-self: flex-start;
  padding: 9rpx 12rpx;
  color: #fff;
  background: #147d78;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 750;
}

.principle-title {
  font-size: 25rpx;
  font-weight: 720;
}

.principle-copy {
  margin-top: 7rpx;
  color: #73777f;
  font-size: 20rpx;
  line-height: 1.55;
}
