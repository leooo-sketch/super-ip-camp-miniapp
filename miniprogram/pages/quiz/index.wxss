.quiz-home, .lobby-page, .quiz-page, .result-page { min-height: 100vh; box-sizing: border-box; padding: 42rpx 28rpx; }.quiz-home { padding-top: 120rpx; }
.home-kicker, .lobby-kicker { color: #147d78; font-size: 21rpx; font-weight: 800; letter-spacing: 4rpx; }.home-title { margin-top: 22rpx; font-size: 48rpx; font-weight: 850; line-height: 1.28; }.home-note { margin: 28rpx 0 62rpx; color: #73787e; font-size: 25rpx; line-height: 1.7; }
.primary-button, .secondary-button { height: 94rpx; border-radius: 12rpx; font-size: 27rpx; font-weight: 750; line-height: 94rpx; }.primary-button { color: #fff; background: #111; }.secondary-button { margin-top: 20rpx; color: #111; background: #fff; border: 1rpx solid #d8dadd; }.home-tip, .waiting-copy { margin-top: 30rpx; color: #92969b; font-size: 20rpx; line-height: 1.6; text-align: center; }
.room-code { margin-top: 18rpx; font-size: 58rpx; font-weight: 900; letter-spacing: 8rpx; }.lobby-note { margin-top: 12rpx; color: #777c82; font-size: 22rpx; }.player-list { margin: 42rpx 0 36rpx; overflow: hidden; background: #fff; border-radius: 14rpx; }.player-row { display: flex; align-items: center; min-height: 96rpx; padding: 0 24rpx; border-bottom: 1rpx solid #eef0f2; }.player-avatar { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; color: #fff; background: #147d78; border-radius: 50%; font-size: 23rpx; font-weight: 800; }.player-name { flex: 1; margin-left: 18rpx; font-size: 25rpx; font-weight: 650; }.ready { color: #147d78; font-size: 20rpx; }
.topline { display: flex; justify-content: space-between; color: #656a70; font-size: 22rpx; }.progress { height: 8rpx; margin-top: 16rpx; overflow: hidden; background: #dfe2e5; border-radius: 9rpx; }.progress-fill { height: 100%; background: #147d78; }.duel { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 0 24rpx; padding: 22rpx 30rpx; color: #fff; background: #151719; border-radius: 12rpx; }.duel-label { display: block; max-width: 180rpx; overflow: hidden; color: #aeb3b7; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }.duel-score { font-size: 32rpx; font-weight: 800; }.vs { color: #f1b932; font-size: 20rpx; font-weight: 800; }
.question-card { padding: 30rpx; background: #fff; border-radius: 14rpx; }.question-meta { display: flex; align-items: center; gap: 12rpx; }.tag, .timer, .double { padding: 7rpx 13rpx; border-radius: 999rpx; font-size: 18rpx; }.tag { color: #0e635f; background: #dff4f2; }.timer { color: #4e5358; background: #eef0f2; }.double { color: #7b5600; background: #fff1c7; }.question { min-height: 130rpx; padding: 34rpx 0 22rpx; font-size: 35rpx; font-weight: 750; line-height: 1.45; }.answer { display: flex; align-items: center; min-height: 88rpx; margin-top: 16rpx; padding: 18rpx; background: #f5f6f7; border: 2rpx solid transparent; border-radius: 10rpx; font-size: 25rpx; }.letter { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; margin-right: 18rpx; background: #fff; border-radius: 8rpx; font-weight: 800; }.answer.right { color: #0e635f; background: #dff4f2; border-color: #147d78; }.answer.wrong { color: #9f211d; background: #ffe9e7; border-color: #e63b32; }
.result-page { padding-top: 130rpx; text-align: center; }.result-kicker { color: #147d78; font-size: 22rpx; font-weight: 700; }.result-title { margin-top: 20rpx; font-size: 42rpx; font-weight: 800; }.final-score { margin: 48rpx 0 10rpx; font-size: 100rpx; font-weight: 800; }.final-score text { color: #7c8085; font-size: 26rpx; }.result-note { margin-bottom: 48rpx; color: #777a80; font-size: 23rpx; }.share-result { margin-top: 20rpx; color: #147d78; background: transparent; font-size: 23rpx; }.loading-page { padding-top: 280rpx; color: #888; text-align: center; }
