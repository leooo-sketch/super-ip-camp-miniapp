<view class="create-page">
  <view class="workflow-head accent-{{workflow.accent}}">
    <view class="workflow-type">{{workflow.category}}</view>
    <view class="workflow-name">{{workflow.title}}</view>
    <view class="workflow-desc">{{workflow.subtitle}}</view>
    <view class="workflow-meta">
      <text>{{workflow.tokenCost}} 创作点</text>
      <text>{{workflow.duration}}</text>
    </view>
  </view>

  <view class="form-section">
    <view class="section-label">1. 创作设定</view>
    <view class="field">
      <view class="field-label">{{topicLabel}}</view>
      <textarea class="textarea" maxlength="240" auto-height placeholder="{{isHyImageVideo ? '例如：镜头缓慢推进，画面中的主体自然转头' : (isHyTextVideo ? '例如：清晨的山间云海，镜头缓慢向前移动' : '例如：下班后坚持训练的第30天，真实、有力量、不夸张')}}" value="{{form.topic}}" data-field="topic" bindinput="handleInput" />
      <view class="counter">{{form.topic.length}} / 240</view>
    </view>
    <view wx:if="{{hasAudience}}" class="field">
      <view class="field-label">目标人群</view>
      <input class="input" value="{{form.audience}}" data-field="audience" bindinput="handleInput" />
    </view>
    <view wx:if="{{hasScene}}" class="field">
      <view class="field-label">场景要求</view>
      <input class="input" placeholder="例如：健身房、自然侧光、手机纪实" value="{{form.scene}}" data-field="scene" bindinput="handleInput" />
    </view>
    <view wx:if="{{showPlatform || showStyle || showRatio || showResolution}}" class="field-grid {{isHyWorkflow ? 'hy-field-grid' : ''}}">
      <picker wx:if="{{showPlatform}}" range="{{platformOptions}}" value="{{platformIndex}}" data-field="platform" bindchange="handlePicker">
        <view class="picker-box"><text class="picker-label">发布平台</text><text>{{platformOptions[platformIndex]}} 〉</text></view>
      </picker>
      <picker wx:if="{{showStyle}}" range="{{styleOptions}}" value="{{styleIndex}}" data-field="style" bindchange="handlePicker">
        <view class="picker-box"><text class="picker-label">视觉风格</text><text>{{styleOptions[styleIndex]}} 〉</text></view>
      </picker>
      <picker wx:if="{{showRatio}}" range="{{ratioOptions}}" value="{{ratioIndex}}" data-field="ratio" bindchange="handlePicker">
        <view class="picker-box"><text class="picker-label">画面比例</text><text>{{ratioOptions[ratioIndex]}} 〉</text></view>
      </picker>
      <picker wx:if="{{showResolution}}" range="{{resolutionOptions}}" value="{{resolutionIndex}}" data-field="resolution" bindchange="handlePicker">
        <view class="picker-box"><text class="picker-label">清晰度</text><text>{{resolutionOptions[resolutionIndex]}} 〉</text></view>
      </picker>
    </view>
    <view wx:if="{{isHyWorkflow}}" class="fixed-spec">固定生成 5 秒 · 720p{{isHyImageVideo ? ' · 画面比例由首帧图片决定' : ''}}</view>
  </view>

  <view wx:if="{{showImageUpload}}" class="form-section">
    <view class="section-label">{{isHyImageVideo ? '2. 首帧图片' : '2. 本人形象素材'}}</view>
    <view class="upload-grid">
      <view wx:for="{{images}}" wx:key="fileId" class="media-tile">
        <image src="{{item.tempPath}}" mode="aspectFill"></image>
        <view class="remove" data-index="{{index}}" bindtap="removeImage">×</view>
      </view>
      <view wx:if="{{images.length < workflow.maxImages}}" class="upload-tile" bindtap="chooseImages">
        <view class="upload-symbol">＋</view>
        <view>{{isHyImageVideo ? '上传首帧' : '上传照片'}}</view>
      </view>
    </view>
    <view wx:if="{{isHyImageVideo}}" class="media-note">仅接收 1 张本人原创或已获授权的 JPG/PNG 图片，不超过 10MB。生成画幅与图片一致。</view>
    <view wx:elif="{{workflow.maxImages === 1}}" class="media-note">请上传 1 张清晰本人照片作为首帧参考，避免过度美颜。</view>
    <view wx:else class="media-note">{{workflow.minImages}}-{{workflow.maxImages}} 张清晰照片，建议正面、侧面和半身，避免过度美颜。</view>

    <block wx:if="{{workflow.mediaMode === 'video-and-images'}}">
      <view class="sub-label">参考视频</view>
      <view wx:if="{{video}}" class="video-row">
        <video class="video-preview" src="{{video.tempPath}}" controls></video>
        <button class="remove-video" bindtap="removeVideo">移除</button>
      </view>
      <view wx:else class="video-upload" bindtap="chooseVideo">
        <view class="upload-symbol">＋</view>
        <view>上传本人拍摄或已授权视频</view>
      </view>
      <view class="media-note">可灵视频编辑要求参考片段为 3-10 秒；只用于授权内容的节奏与镜头结构重构，不应包含未授权人物、音乐或水印。</view>
    </block>
  </view>

  <view class="form-section">
    <view class="section-label">{{rightsSectionTitle}}</view>
    <picker wx:if="{{showSourcePicker}}" range="{{sourceOptions}}" value="{{sourceIndex}}" data-field="source" bindchange="handlePicker">
      <view class="source-picker"><text>素材来源</text><text>{{sourceOptions[sourceIndex]}} 〉</text></view>
    </picker>
    <view class="switch-row">
      <view><view class="switch-title">{{isHyTextVideo ? '创作内容权利确认' : '素材权利确认'}}</view><view class="switch-note">{{isHyTextVideo ? '提示词和生成内容不用于冒充他人或侵犯他人权利' : '我拥有素材，或已取得人物肖像、视频、音乐等必要授权'}}</view></view>
      <switch color="#147D78" checked="{{form.authorized}}" data-field="authorized" bindchange="handleSwitch" />
    </view>
    <view class="switch-row">
      <view><view class="switch-title">AI 内容标识</view><view class="switch-note">发布时添加“AI生成”或“AI辅助创作”标识</view></view>
      <switch color="#147D78" checked="{{form.aiDisclosure}}" data-field="aiDisclosure" bindchange="handleSwitch" />
    </view>
    <view wx:if="{{hasRemoveAudio}}" class="switch-row">
      <view><view class="switch-title">移除参考音频</view><view class="switch-note">避免沿用参考视频中的音乐与人声</view></view>
      <switch color="#147D78" checked="{{form.removeAudio}}" data-field="removeAudio" bindchange="handleSwitch" />
    </view>
  </view>

  <view class="submit-spacer"></view>
  <view class="submit-bar">
    <view><view class="submit-cost">{{workflow.tokenCost}} 创作点</view><view class="submit-note">{{isHyWorkflow ? '提交时预扣，失败按规则退还' : '创建成功后扣除'}}</view></view>
    <button class="submit-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">开始创作</button>
  </view>
</view>
