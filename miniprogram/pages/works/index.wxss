.works-page { padding: 28rpx; }
.works-head { display: flex; align-items: center; justify-content: space-between; }
.works-title { font-size: 38rpx; font-weight: 800; }
.works-note { margin-top: 4rpx; color: #7b7f86; font-size: 21rpx; }
.new-button { width: 150rpx; height: 68rpx; color: #fff; background: #e63b32; font-size: 23rpx; line-height: 68rpx; }
.filters { margin: 28rpx 0 22rpx; white-space: nowrap; }
.filter-row { display: flex; gap: 12rpx; }
.filter { flex: 0 0 auto; padding: 14rpx 24rpx; color: #5f636a; background: #fff; border: 1rpx solid #dfe1e5; border-radius: 999rpx; font-size: 22rpx; }
.filter.active { color: #fff; background: #151719; border-color: #151719; }
.task-list { display: flex; flex-direction: column; gap: 16rpx; }
.task-card { display: flex; overflow: hidden; min-height: 216rpx; background: #fff; border: 1rpx solid #e4e6ea; border-radius: 12rpx; }
.task-cover-shell { position: relative; flex: 0 0 190rpx; width: 190rpx; height: 216rpx; }
.task-cover { flex: 0 0 190rpx; width: 190rpx; height: 216rpx; }
.task-ai-label { position: absolute; left: 10rpx; bottom: 10rpx; padding: 5rpx 9rpx; color: #fff; background: rgba(0,0,0,.72); border-radius: 5rpx; font-size: 17rpx; font-weight: 700; }
.task-body { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 20rpx; }
.task-top,.task-foot { display: flex; align-items: center; justify-content: space-between; }
.status { color: #0e635f; font-size: 20rpx; font-weight: 700; }
.status-processing,.status-queued { color: #876003; }
.status-failed { color: #b92520; }
.time { color: #96999f; font-size: 18rpx; }
.task-name { margin-top: 14rpx; font-size: 27rpx; font-weight: 750; }
.task-topic { overflow: hidden; margin-top: 7rpx; color: #73777f; font-size: 21rpx; white-space: nowrap; text-overflow: ellipsis; }
.task-foot { margin-top: auto; color: #777a80; font-size: 19rpx; }
.empty-title { color: #151719; font-size: 28rpx; font-weight: 750; }
.empty-note { margin: 10rpx 0 24rpx; line-height: 1.5; }
.empty-button { width: 220rpx; height: 72rpx; color: #fff; background: #e63b32; font-size: 23rpx; line-height: 72rpx; }
