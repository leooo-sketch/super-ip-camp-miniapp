.profile-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; }
.loading-card { margin-top: 80rpx; color: #858990; font-size: 24rpx; text-align: center; }
.guest-head { padding: 34rpx 6rpx 10rpx; }
.guest-brand { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; color: #fff; background: #151719; border-radius: 22rpx; font-size: 32rpx; font-weight: 900; }
.guest-title { margin-top: 30rpx; font-size: 44rpx; font-weight: 850; letter-spacing: -2rpx; }
.guest-copy { margin-top: 14rpx; color: #6f747a; font-size: 23rpx; line-height: 1.7; }
.login-card { margin-top: 30rpx; padding: 30rpx; background: #fff; border: 1rpx solid #e4e6ea; border-radius: 18rpx; box-shadow: 0 12rpx 36rpx rgba(17, 17, 17, .05); }
.profile-input-row { display: flex; align-items: center; gap: 20rpx; padding-bottom: 24rpx; }
.avatar-button { width: 92rpx; height: 92rpx; margin: 0; padding: 0; background: transparent; border-radius: 50%; }
.avatar-button::after { border: 0; }
.login-avatar { width: 92rpx; height: 92rpx; border-radius: 50%; }
.login-avatar-placeholder { display: flex; align-items: center; justify-content: center; color: #147d78; background: #e4f4f2; font-size: 42rpx; }
.profile-input-body { flex: 1; min-width: 0; }
.input-label { color: #7a7f85; font-size: 19rpx; }
.nickname-input { height: 66rpx; margin-top: 4rpx; padding: 0 18rpx; background: #f4f5f7; border-radius: 9rpx; font-size: 24rpx; }
.login-button { height: 88rpx; margin-top: 16rpx; border-radius: 12rpx; font-size: 26rpx; font-weight: 750; line-height: 88rpx; }
.wechat-button { color: #fff; background: #07c160; }
.phone-button { color: #151719; background: #fff; border: 2rpx solid #d9dde1; }
.login-legal { margin-top: 22rpx; color: #999da2; font-size: 18rpx; line-height: 1.6; text-align: center; }
.guest-benefits { margin-top: 22rpx; padding: 4rpx 26rpx; background: #202427; border-radius: 14rpx; }
.benefit { display: flex; align-items: center; gap: 20rpx; padding: 23rpx 0; color: #fff; border-bottom: 1rpx solid rgba(255,255,255,.1); font-size: 23rpx; font-weight: 650; }
.benefit:last-child { border-bottom: 0; }
.benefit > text { color: #f1b932; font-size: 18rpx; letter-spacing: 1rpx; }
.benefit-note { margin-top: 4rpx; color: #9da2a7; font-size: 18rpx; font-weight: 400; }
.guest-about { padding: 28rpx 0 10rpx; color: #6f747a; font-size: 21rpx; text-align: center; }
.identity { display: flex; align-items: center; gap: 20rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; color: #fff; background: #151719; border-radius: 50%; font-size: 30rpx; font-weight: 800; }
.nickname { font-size: 34rpx; font-weight: 800; }
.plan { margin-top: 5rpx; color: #777a80; font-size: 21rpx; }
.balance-panel { margin-top: 28rpx; padding: 30rpx; color: #fff; background: #147d78; border-radius: 12rpx; }
.balance-top { display: flex; align-items: center; justify-content: space-between; }
.balance-label { color: rgba(255,255,255,.72); font-size: 20rpx; font-weight: 700; }
.balance-link { color: #fff; font-size: 21rpx; font-weight: 700; }
.balance-value { margin-top: 7rpx; font-size: 64rpx; font-weight: 800; }
.balance-note { color: rgba(255,255,255,.72); font-size: 20rpx; }
.menu-panel { margin-top: 22rpx; padding: 0 26rpx; background: #fff; border: 1rpx solid #e4e6ea; border-radius: 12rpx; }
.menu-row { display: flex; align-items: center; justify-content: space-between; padding: 25rpx 0; border-bottom: 1rpx solid #eceef0; }
.menu-row:last-child { border-bottom: 0; }
.menu-title { font-size: 25rpx; font-weight: 680; }
.menu-note { margin-top: 5rpx; color: #858990; font-size: 19rpx; }
.danger-row .menu-title { color: #b92520; }
.mind-break { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 24rpx 26rpx; color: #d6d9dc; background: #202427; border-radius: 12rpx; }
.mind-kicker { color: #f1b932; font-size: 18rpx; letter-spacing: 2rpx; }
.mind-title { margin-top: 5rpx; color: #fff; font-size: 27rpx; font-weight: 700; }
.mind-link { color: #9da2a7; font-size: 20rpx; }
.policy-panel { margin-top: 22rpx; padding: 25rpx; background: #fff1c7; border-left: 7rpx solid #f1b932; border-radius: 8rpx; }
.policy-title { color: #654807; font-size: 24rpx; font-weight: 750; }
.policy-copy { margin-top: 8rpx; color: #715a26; font-size: 21rpx; line-height: 1.6; }
.privacy-consent-row { margin-bottom: 22rpx; padding: 22rpx; background: #f7f8fa; border-radius: 12rpx; }
.privacy-checkbox-label { display: flex; align-items: center; gap: 10rpx; color: #34383c; font-size: 21rpx; }
.privacy-link-row { margin-top: 10rpx; padding-left: 54rpx; color: #757a80; font-size: 20rpx; line-height: 1.6; }
.privacy-link { color: #147d78; font-weight: 650; }
.input-disabled { opacity: .55; }
.privacy-mask { position: fixed; z-index: 9999; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(0,0,0,.48); box-sizing: border-box; }
.privacy-dialog { width: 100%; max-width: 620rpx; padding: 38rpx 34rpx 30rpx; background: #fff; border-radius: 20rpx; box-sizing: border-box; }
.privacy-dialog-title { color: #151719; font-size: 32rpx; font-weight: 800; text-align: center; }
.privacy-dialog-copy { margin-top: 24rpx; color: #62676d; font-size: 23rpx; line-height: 1.75; }
.privacy-dialog-actions { display: flex; gap: 18rpx; margin-top: 34rpx; }
.privacy-cancel, .privacy-confirm { flex: 1; height: 82rpx; margin: 0; border-radius: 10rpx; font-size: 24rpx; line-height: 82rpx; }
.privacy-cancel { color: #4f5459; background: #f2f3f5; }
.privacy-confirm { color: #fff; background: #07c160; }
.privacy-cancel::after, .privacy-confirm::after { border: 0; }
