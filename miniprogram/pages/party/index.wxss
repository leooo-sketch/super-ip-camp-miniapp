.party-page, .lobby-page, .play-page { min-height: 100vh; box-sizing: border-box; padding: 40rpx 28rpx; }.party-title { font-size: 44rpx; font-weight: 800; }.party-note { margin-top: 12rpx; color: #777a80; font-size: 22rpx; line-height: 1.65; }
.game-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 38rpx; }.party-card { min-height: 220rpx; padding: 25rpx; background: #fff; border: 1rpx solid #e4e6ea; border-radius: 12rpx; }.party-icon { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; color: #151719; background: #f1b932; border-radius: 8rpx; font-weight: 800; }.party-name { margin-top: 20rpx; font-size: 27rpx; font-weight: 750; }.party-desc { min-height: 55rpx; margin-top: 5rpx; color: #878b90; font-size: 19rpx; line-height: 1.45; }.create-copy { margin-top: 16rpx; color: #147d78; font-size: 19rpx; font-weight: 700; }
.lobby-kicker, .play-kicker { color: #147d78; font-size: 21rpx; font-weight: 800; }.room-code { margin-top: 16rpx; font-size: 58rpx; font-weight: 900; letter-spacing: 8rpx; }.lobby-note { margin-top: 12rpx; color: #777c82; font-size: 22rpx; }.player-list { margin: 42rpx 0 36rpx; overflow: hidden; background: #fff; border-radius: 14rpx; }.player-row { display: flex; align-items: center; min-height: 96rpx; padding: 0 24rpx; border-bottom: 1rpx solid #eef0f2; }.player-dot { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; color: #fff; background: #147d78; border-radius: 50%; font-size: 22rpx; font-weight: 800; }.player-name { flex: 1; margin-left: 18rpx; font-size: 25rpx; font-weight: 650; }.ready { color: #147d78; font-size: 20rpx; }
.primary-button, .secondary-button { height: 94rpx; border-radius: 12rpx; font-size: 27rpx; font-weight: 750; line-height: 94rpx; }.primary-button { color: #fff; background: #111; }.secondary-button { margin-top: 20rpx; color: #111; background: #fff; border: 1rpx solid #d8dadd; }.waiting-copy, .back-link { margin-top: 28rpx; color: #92969b; font-size: 21rpx; text-align: center; }.back-link { color: #147d78; }
.play-head { display: flex; align-items: center; justify-content: space-between; }.play-title { margin-top: 8rpx; font-size: 42rpx; font-weight: 850; }.mini-share { margin: 0; padding: 0 22rpx; color: #147d78; background: #e5f4f2; font-size: 20rpx; }.player-chips { margin-top: 34rpx; white-space: nowrap; }.chip { display: inline-block; margin-right: 12rpx; padding: 13rpx 22rpx; color: #62676d; background: #fff; border-radius: 999rpx; font-size: 21rpx; }.active-chip { color: #fff; background: #147d78; }.round-card { min-height: 420rpx; margin: 30rpx 0; padding: 42rpx 32rpx; background: #fff; border-radius: 16rpx; text-align: center; }.turn-name { color: #147d78; font-size: 21rpx; font-weight: 750; }.round-prompt { padding: 50rpx 0 34rpx; font-size: 34rpx; font-weight: 750; line-height: 1.55; }.secret-card { padding: 26rpx; color: #fff; background: #151719; border-radius: 12rpx; }.secret-label { color: #f1b932; font-size: 19rpx; }.secret-word { margin: 16rpx 0; font-size: 48rpx; font-weight: 900; }.secret-note { color: #9ca0a5; font-size: 18rpx; }.range { margin-top: 20rpx; font-size: 30rpx; font-weight: 800; }.guess-row { display: flex; gap: 14rpx; margin-top: 24rpx; }.guess-input { flex: 1; height: 82rpx; padding: 0 20rpx; background: #f1f2f4; border-radius: 10rpx; }.guess-row button { width: 170rpx; height: 82rpx; color: #fff; background: #147d78; font-size: 23rpx; line-height: 82rpx; }.loading-page { padding-top: 280rpx; color: #888; text-align: center; }
